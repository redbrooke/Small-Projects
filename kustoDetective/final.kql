DetectiveCases
| where isnotnull(Properties)
| project CaseId, Properties
| join kind=rightouter DetectiveCases on CaseId
| where EventType == "CaseSolved" and isnotnull(Properties)
| summarize arg_min(Timestamp, *) by CaseId
| extend payout = toint(Properties.Bounty)
| distinct CaseId, DetectiveId, payout
| summarize sum(payout) by DetectiveId
| order by sum_payout

Consumption
| where Consumed > 0
| distinct Timestamp, HouseholdId, MeterType, Consumed
| join kind=leftouter Costs on MeterType
| extend bill = (Consumed * Cost)
| summarize sum(bill)

PhoneCalls
| extend hidden = Properties.IsHidden
| where hidden == True
| join PhoneCalls on CallConnectionId
| extend hangup = Properties1.DisconnectedBy
| where hangup == "Destination"
| extend caller = Properties.Origin 
| summarize count() by tostring(caller)
| order by count_

10/06/2023, 14:10:00

CarsTraffic
| join kind=rightouter StolenCars on VIN
| summarize arg_max(Timestamp, *) by VIN
| project-away VIN1
// the next line pulls cars that were parked at the same place as stolen cars.
| join kind=inner CarsTraffic on Ave, Street 
| project-away Ave1, Street1
// drop ones before the stolen car arrived
| where Timestamp < Timestamp1
| where abs(datetime_diff('minute', Timestamp, Timestamp1)) <= 5
| extend Timestamp = Timestamp1, VIN = VIN1
| project-away Timestamp1, VIN1
// Pulls in the data to find the final dest
| join CarsTraffic on VIN
| project-away VIN1
| where Timestamp < Timestamp1
// takes the last known location of the final VIN
| summarize arg_max(Timestamp1, *) by VIN
| extend dest = strcat(Ave1, " " , Street1)
| summarize count() by dest
| order by count_


