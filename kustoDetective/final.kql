StorageArchiveLogs
| parse EventText with TransactionType " blob transaction: '" BlobURI "'" *
| parse EventText with * "(" Reads:long "reads)" *
| parse EventText with * "completely " removed
//| where removed != "" or TransactionType != "Delete"
| project-away removed
//| extend Host = tostring(parse_url(BlobURI).Host)
| summarize totalread=sumif(Reads, TransactionType == 'Read'), totalcreate=sumif(1, TransactionType == 'Create'), totaldelete=sumif(1, TransactionType == 'Delete'),  finalSeen = arg_max(Timestamp, *), firstSeen = arg_min(Timestamp, *) by BlobURI
| where totalcreate != 0 and totaldelete != 0
| project-away Reads, TransactionType1, Reads1, TransactionType
| extend badTime = datetime_diff('minute', finalSeen, firstSeen)
| where badTime < 4320 // three days
| order by badTime asc 

