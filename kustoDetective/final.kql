) on key
| where Timestamp between (datetime("08/11/2023, 03:30:00")..datetime("08/11/2023, 05:30:00"))
| project callsign, Timestamp
| summarize startTime=arg_max(Timestamp, *) by callsign); // DO WE NEED STARTTIME HERE?
let possible_first_flight_history = (possible_first_flights
| join Flights on callsign
| where Timestamp > startTime
| project-away startTime, callsign1
| extend LocationCode=geo_point_to_s2cell(lon, lat, s2_precision)
| project callsign, LocationCode, Timestamp, dohaalt = geoaltitude
);
let overlapping_flights =(Flights
| extend LocationCode=geo_point_to_s2cell(lon, lat, s2_precision)
| where onground == false
| join possible_first_flight_history on LocationCode
| where callsign != callsign1
| where Timestamp1 between (Timestamp - 15m .. Timestamp + 30m)
| where dohaalt > geoaltitude
| project callsign , overlapTime = Timestamp
| summarize overlapTime=arg_max(overlapTime, *) by callsign
);
let finalDest = (overlapping_flights
| join Flights on callsign
| where Timestamp > overlapTime 
| where onground == true
| extend key=geo_point_to_s2cell(lon, lat,12), LandingLat = lat, LandingLon = lon
| project-away lat, lon, callsign1
| summarize finalLocation=arg_min(Timestamp, *) by callsign);
