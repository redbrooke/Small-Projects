let possible_first_flights = (   
Airports
| where Name == "Hamad International Airport"
| extend key=geo_point_to_s2cell(lon, lat, 10)
| join kind=inner (
    Flights
    | extend key=geo_point_to_s2cell(lon, lat, 10)
