let decode = ransomeNote
| project Text=tostring(Text)
| project Text = tolower(Text)
| project Text=replace_strings(Text,  dynamic(['.', ',', ':', '\'', '-']), dynamic([' ',' ',' ',' ',' ']))
| extend output = extract_all(@'(^|)(\d+)/(\d+)(|\n|\r)', Text)
| mv-expand output
| mv-expand ObjectId = output[1], strNumber=output[2]
| project-away Text, output
| project tolong(ObjectId), strNumber
| serialize RowOrder = row_number()
//| take 22
| join kind=leftouter NationalGalleryArt on ObjectId
| order by RowOrder asc
| project ProvenanceText=tolower(ProvenanceText), ObjectId, strNumber
| project ProvenanceText=strcat(ProvenanceText), ObjectId, strNumber 
//| project ProvenanceText=replace_regex(ProvenanceText, @"\'", ""), ObjectId, strNumber // remove ALL apostrophes
//| where ObjectId == "42420" //DELETEME!!!!!!!!!!!!
//| project ProvenanceText=replace_regex(ProvenanceText, @"(?:\D)-(?:\D)", ""), ObjectId, strNumber // remove hyphons not within dates.
//| project ProvenanceText=replace_regex(ProvenanceText, @"*//*", " "), ObjectId, strNumber // REmove all slashes            \[\d\]|\[\d\d\] ?????????????????????/
//| project ProvenanceText=replace_regex(ProvenanceText, @"\[\d\]|\[\d\d\]*", " "), ObjectId, strNumber // REMOVE ALL REFERENCES
//| project ProvenanceText=replace_regex(ProvenanceText, @"[[:punct:]]", " "), ObjectId, strNumber // Remove all other punctuation
//| project ProvenanceText=replace_regex(ProvenanceText,@"(\b[A-Za-z]+\b|\b[a-zA-Z]*'[a-zA-Z]+\b)", ""), ObjectId, strNumber // \b[A-Za-z]+\b|\b[a-zA-Z]*'[a-zA-Z]+\b
//| project ProvenanceText=replace_regex(ProvenanceText,@'\d', ""), ObjectId, strNumber// EXPERIMENT, DROP ALL NUMBERS
//| extend words = extract_all(@'(\S+?)[ |$]', ProvenanceText) // FIX ME REMOVE THE [123 345]
//| extend words = extract_all(@"(\b[A-Za-z]+\b|\b[a-zA-Z]*'[a-zA-Z]+\b|\b[\d]+\b)", ProvenanceText) 
| extend words = extract_all(@"(\w+)", ProvenanceText) 
| extend strNumber= toint(strNumber)
| summarize target = make_list(strcat(tostring(ObjectId), "/", tostring(strNumber))), words = make_list(words[strNumber])
| project target, words, key="FUBAR";
ransomeNote
| extend key="FUBAR"
| join decode on key
| extend  NewText = replace_strings(tostring(Text), target, words)
| project NewText

