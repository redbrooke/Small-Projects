| where Message !has "started ('CaseUnsolved'). Captured user"
| where Message !has " completed: user encryption token for this"
| where Message !has "User session reset: all user encryption tokens are disposed."
| where Message !has "User entered the system, start collecting user encryption tokens."



// Sending an encrypted message, will use Dekrypt(@'tBhku8uLuQULuDTou8udZDuduBiluQikuQiku4ERh4vV5\LEmeI9RGZYIXiCr[08ZBh[5e0e0DU6u848ZQ575DoyuXI95tyBR\16I6ijhO48ROY\0nv7I\16hO1l5[TyIP2Em\S9ROWj0tyBhO4l0KvB0tyUrtyChP2g0tA9ROJ9n[1Vme2VFXvh5GvkcnverGZgrtyChp==', strcat_array(<active-user-encryption-tokens>, '')) for decoding.

.create-or-alter function with (skipvalidation = "true") Dekrypt(T:(Message:string,Key:string)) { 
    let lx=array_concat(range(48, 57, 1), range(65, 92, 1), range(97, 122, 1));
    let uc = (_s:string) { unicode_codepoints_from_string(hash_sha256(_s))};
    T 
    | extend c1 = uc(tolower(Key)), c2 = uc(toupper(Key))
    | mv-apply with_itemindex=i l=lx to typeof(int), c=c1 to typeof(int) on (order by c asc, i asc | summarize c1=unicode_codepoints_to_string(make_list(l)))
    | mv-apply with_itemindex=i l=lx to typeof(int), c=c2 to typeof(int) on (order by c asc, i asc | summarize c2=unicode_codepoints_to_string(make_list(l)))
    | extend Result = coalesce(base64_decode_tostring(translate(c1, c2, Message)), "Failure: wrong key")
    | project-away c1, c2
}


KuandaLogs
| where DetectiveId == "kvc134a34251e76943710a"
| order by Timestamp
| distinct *

KuandaLogs
| search "3f3352e693b854d7"



KuandaLogs
//| where DetectiveId == "kvc470de475c64ad8907b1"
//| parse-where Message with "Sending an encrypted message, will use Dekrypt(@'"encryptedMessage"', strcat_array(<active-user-encryption-tokens>, \'\')) for decoding." 
//| distinct Timestamp, DetectiveId, encryptedMessage
//| join KuandaLogs on DetectiveId
| where Message has "sending"
| distinct  DetectiveId
| join KuandaLogs on DetectiveId
| project-away DetectiveId1
| distinct *
| partition hint.strategy=native by DetectiveId(
  order by Timestamp asc
  | scan with_match_id=stepCount declare(Token:dynamic, Output:dynamic ) with(
    step start output=all: Message has "User entered the system" or Message has "User session reset"  => Token = dynamic([]);
    step token output=all: Message has "Captured user" or Message has "completed: user" => Token = iff(Message has "Captured user",
     //bag_merge(   token.Token,  bag_pack(tostring(split(Message, " ", 1)), tostring(split(Message, " ", 8)))   ),
     bag_merge(   token.Token,  bag_pack(tostring(split(Message, " ", 1)[0]), tostring(split(Message, " ", 8)[0]))   ),
     bag_remove_keys(token.Token, split(Message, " ", 1) ) 
     );
    step HIT output=all: Message has "Sending an encrypted" => Output = token.Token, Token = dynamic([]);
   )
)
| order by Timestamp
| where Message has "Sending"
| mv-expand bagexpansion=array pair = Output
| extend value = tostring(pair[1])
| summarize Values = tostring(make_list(value)) by Message
//| summarize Values = tostring(array_reverse(make_list(value))) by Message // array_reverse(), is this needed?
| extend Key = replace_regex(Values, @'[^a-zA-Z]', '') 
| parse-where Message with "Sending an encrypted message, will use Dekrypt(@'"encryptedMessage"', strcat_array(<active-user-encryption-tokens>, \'\')) for decoding." 
| project Message = encryptedMessage,  Key = Key
| invoke Dekrypt()
| join (KuandaLogs | parse-where Message with "Sending an encrypted message, will use Dekrypt(@'"encryptedMessage"', strcat_array(<active-user-encryption-tokens>, \'\')) for decoding." | project Message = encryptedMessage, DetectiveId ) on Message
| project-away Message1
| distinct  *
//| where Result !has "endpoint is not reachable"
//| where Result !has "sending them to Kuanda"
//| where Result !has "returned an error"
| extend crash = bitset_count_ones(hash_many(tostring(DetectiveId), tostring(Key)))
| order by crash
| extend bitset_count_ones(hash_xxhash64(DetectiveId))

//xxHash64
range i from 0 to 2147483647 step 1
| where ones = bitset_count_ones(hash_many('kvc-rusq7k0qp2g2dwpm6q', tostring(i))) > 54
| project i

