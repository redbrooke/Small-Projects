KuandaLogs
//| where DetectiveId == "kvc470de475c64ad8907b1"
| partition hint.strategy=native by DetectiveId
(
    order by Timestamp asc 
     | scan with_match_id=id  declare(StartTime:datetime, EndTime:datetime) with (
        step start output=none: 
			Message has 'User entered the system, start collecting user encryption tokens.' => StartTime = Timestamp;
        //step hit output=all:
        //    Message has 'started (\'CaseAssigned\'). Captured user encryption token:';
        step noStop output=none:
            Message !has 'User session reset: all user encryption tokens are disposed.';
        step completed output=all:
			Message has "completed: user encryption token for this operation is disposed.";
    )
    | parse-where Message with "Operation id="operationId" completed: user encryption token for this operation is disposed."
    | project DetectiveId, operationId
)
| join (KuandaLogs | parse-where Message with "Operation id="operationId" completed: user encryption token for this operation is disposed.") on operationId




KuandaLogs
//| where DetectiveId == "kvc470de475c64ad8907b1"
| parse-where Message with "Sending an encrypted message, will use Dekrypt(@'"encryptedMessage"', strcat_array(<active-user-encryption-tokens>, \'\')) for decoding." 
| distinct Timestamp, DetectiveId, encryptedMessage
| join KuandaLogs on DetectiveId
| distinct encryptedMessage, DetectiveId, encryptTime = Timestamp
| join KuandaLogs on DetectiveId
| distinct *
| partition hint.strategy=native by DetectiveId(
  order by Timestamp asc
  | scan with_match_id=stepCount declare(SessionStartTime:datetime, EndTime:datetime, Token:dynamic) with(
    step start output=all: Message has "User entered the system" or Message has "User session reset"  => SessionStartTime = Timestamp, Token = dynamic([]);
    step token output=all: Message has "Captured user" or Message has "diposed" => Token = iff(Message has "Captured user",
     bag_merge(Token, bag_pack(tostring(split(Message, " ", 1)), tostring(split(Message, " ", 8)))),
     bag_remove_keys(Token, split(Message, " ", 1)) 
     );
    step HIT output=all: Timestamp > encryptTime and Message has "Sending" => EndTime = Timestamp, Token = token.Token;
   )
  // Fine where session is entered most recently before timestamp
  // Grab all tokens inbetween
  // Stop at the first "Session reset" after the encryptTIme
)
| order by Timestamp
| extend target = bag_values(Token)

| extend finalKey = extract(@"([a-zA-Z]+)", 1, tostring(Token))

// pack_array(tostring(split(Message, " ", 1), extract(@"([a-zA-Z]+)", 1, tostring(split(Message, " ", 8)[0])) 
| where Message has "sending"
| project Message = encryptedMessage, Key = strcat_array(Token, '')
| invoke Dekrypt()

| where Result != "Failure: wrong key"
// At the time of each token, find all valid session IDs

| join KuandaLogs() on  operationId// EXTRACT ALL OPERATION IDS FROM VALID TARGETS

KuandaLogs
| where Message !has "User session reset: all user encryption tokens are disposed."
| where Message !has "User entered the system, start collecting user encryption tokens."
| distinct *
| parse-where Message with "Operation id="operationId" "*
// At the time of each token, find all valid session IDs

| partition hint.strategy=native by operationId(
  order by Timestamp asc 
  | scan with_match_id=stepCount declare(StartTime:datetime, EndTime:datetime) with(
    step start output=all: Message has 'started'; // => StartTime = Timestamp;
    //step hit output=all: Message has " ";//Captured user encryption";
    step finish output=none: Message has "completed";
  )
)
| summarize count() by operationId

| partition hint.strategy=native by DetectiveId
(
    order by Timestamp asc 
     | scan with_match_id=id  declare(StartTime:datetime, EndTime:datetime) with (
        step start output=none: 
			Message has 'User entered the system, start collecting user encryption tokens.' => StartTime = Timestamp;
        //step hit output=all:
        //    Message has 'started (\'CaseAssigned\'). Captured user encryption token:';
        step noStop output=none:
            Message !has 'User session reset: all user encryption tokens are disposed.';
        step completed output=all:
			Message has "completed: user encryption token for this operation is disposed.";
    )
    | parse-where Message with "Operation id="operationId" completed: user encryption token for this operation is disposed."
    | project DetectiveId, operationId
)
| join (KuandaLogs | parse-where Message with "Operation id="operationId" started ('"status"'). Captured user encryption token: '"captured"'.") on operationId
//| order by operationId

| order by Timestamp
| project-away DetectiveId1, Timestamp, Message, operationId1
| distinct *
| summarize make_list(captured) by operationId, DetectiveId
| summarize make_list(list_captured) by DetectiveId
| extend joined = strcat_array(list_list_captured, "")
| join (KuandaLogs | parse-where Message with "Sending an encrypted message, will use Dekrypt(@'"encryptedMessage"', strcat_array(<active-user-encryption-tokens>, \'\')) for decoding." | project encryptedMessage, DetectiveId ) on DetectiveId
| project Message = encryptedMessage, Key = joined
| invoke Dekrypt()

| extend cleanmessage = Dekrypt(, joined, '')

